<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
            android:name="android.hardware.microphone"
            android:required="false" />
    <uses-feature
            android:name="android.hardware.telephony"
            android:required="false" />
    <uses-feature
            android:required="false"
            android:name="android.hardware.touchscreen" />
    <uses-feature
            android:name="android.hardware.wifi"
            android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
            android:name="android.permission.FOREGROUND_SERVICE"
            tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission
            android:name="android.permission.READ_CALL_LOG"
            tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission
            android:name="android.permission.INTERNAL_SYSTEM_WINDOW"
            tools:ignore="ProtectedPermissions" />
    <uses-permission
            android:name="android.permission.READ_SMS"
            tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission
            android:name="android.permission.RECEIVE_MMS"
            tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission
            android:name="android.permission.SEND_SMS"
            tools:ignore="SmsAndCallLogPolicy" />
    <!--suppress DeprecatedClassUsageInspection -->
    <uses-permission
            android:name="android.permission.PROCESS_OUTGOING_CALLS"
            tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission
            android:name="android.permission.WRITE_CALL_LOG"
            tools:ignore="SmsAndCallLogPolicy" />
    <uses-permission
            android:name="android.permission.WRITE_BLOCKED_NUMBERS"
            tools:ignore="ProtectedPermissions" />
    <uses-permission
            android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
            tools:ignore="ScopedStorage" />

    <application
            android:requestLegacyExternalStorage="true"
            android:name="org.mjdev.safedialer.app.MainApp"
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:allowAudioPlaybackCapture="true"
            android:allowClearUserData="true"
            android:appCategory="social"
            android:autoRevokePermissions="disallowed"
            android:largeHeap="true"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.SplashScreen.Splash">

        <activity
                android:largeHeap="true"
                android:name=".activity.MainActivity"
                android:launchMode="singleTask"
                android:alwaysRetainTaskState="true"
                android:configChanges="orientation|screenSize|screenLayout|keyboard"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
                android:largeHeap="true"
                android:name="com.nabinbhandari.android.permissions.PermissionsActivity"
                android:theme="@style/Permissions.TransparentTheme" />

        <receiver
                android:name=".widget.app.AppWidgetReceiver"
                android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                    android:name="android.appwidget.provider"
                    android:resource="@xml/app_widget" />
        </receiver>

        <receiver
            android:name=".widget.media.MediaPlayerWidgetReceiver"
            android:exported="true">
            <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_player_widget" />
        </receiver>

        <receiver
                android:name="org.mjdev.safedialer.service.calls.IncomingCallBroadcastReceiver"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
                android:name="org.mjdev.safedialer.service.BootReceiver"
                android:enabled="true"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
                android:largeHeap="true"
                android:name="org.mjdev.safedialer.service.IncomingCallService"
                android:exported="false"
                android:foregroundServiceType="phoneCall" />

        <service
                android:largeHeap="true"
                android:name=".sync.SyncAuthenticatorService"
                android:exported="true"
                android:permission="android.permission.BIND_ACCOUNT_AUTHENTICATOR">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                    android:name="android.accounts.AccountAuthenticator"
                    android:resource="@xml/authenticator" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.calendar.ProviderCalendar"
                android:authorities="@string/authority_calendar"
                android:exported="true"
                android:label="@string/sync_label_calendar"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.calendar.SyncServiceCalendar"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_calendar">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_calendar" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.calllog.ProviderCallLog"
                android:authorities="@string/authority_call_log"
                android:exported="true"
                android:label="@string/sync_label_call_log"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.calllog.SyncServiceCallLog"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_call_log">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_call_log" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.contact.ProviderContacts"
                android:authorities="@string/authority_contacts"
                android:exported="true"
                android:label="@string/sync_label_contacts"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.contact.SyncServiceContacts"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_contacts">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_contacts" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.email.ProviderEmails"
                android:authorities="@string/authority_emails"
                android:exported="true"
                android:process="@string/authority_emails"
                android:label="@string/sync_label_emails"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.email.SyncServiceEmails"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_emails">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_emails" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.gallery.ProviderGallery"
                android:authorities="@string/authority_gallery"
                android:exported="true"
                android:label="@string/sync_label_gallery"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.gallery.SyncServiceGallery"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_gallery">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_gallery" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.task.ProviderTasks"
                android:authorities="@string/authority_tasks"
                android:exported="true"
                android:label="@string/sync_label_tasks"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.task.SyncServiceTasks"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_tasks">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_tasks" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.ai.ProviderAI"
                android:authorities="@string/authority_ai"
                android:exported="true"
                android:label="@string/sync_label_ai"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.ai.SyncServiceAI"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_ai">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_ai" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.messages.ProviderMessages"
                android:authorities="@string/authority_messages"
                android:exported="true"
                android:label="@string/sync_label_messages"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.messages.SyncServiceMessages"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_messages">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_messages" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.invoices.ProviderInvoices"
                android:authorities="@string/authority_invoices"
                android:exported="true"
                android:label="@string/sync_label_invoices"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.invoices.SyncServiceInvoices"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_invoices">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_invoices" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.authenticator.ProviderAuthenticator"
                android:authorities="@string/authority_authenticator"
                android:exported="true"
                android:label="@string/sync_label_authenticator"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.authenticator.SyncServiceAuthenticator"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_authenticator">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_authenticator" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.notes.ProviderNotes"
                android:authorities="@string/authority_notes"
                android:exported="true"
                android:label="@string/sync_label_notes"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.notes.SyncServiceNotes"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_notes">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_notes" />
        </service>

        <provider
                android:largeHeap="true"
                android:name=".sync.document.ProviderDocuments"
                android:authorities="@string/authority_documents"
                android:exported="true"
                android:label="@string/sync_label_documents"
                android:grantUriPermissions="true" />

        <service
                android:largeHeap="true"
                android:name=".sync.document.SyncServiceDocuments"
                android:exported="true"
                android:permission="android.permission.BIND_SYNC_ADAPTER"
                android:label="@string/sync_label_documents">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                    android:name="android.content.SyncAdapter"
                    android:resource="@xml/sync_adapter_documents" />
        </service>

    </application>

</manifest>