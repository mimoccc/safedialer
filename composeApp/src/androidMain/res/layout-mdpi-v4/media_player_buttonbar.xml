<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center_vertical"
        android:id="@+id/buttonbar"
        android:background="@drawable/player_common"
        android:paddingLeft="10.0dip"
        android:paddingRight="10.0dip"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

    <ImageButton
            android:id="@id/nowplaying_list"
            android:background="@android:color/transparent"
            android:padding="0.0dip"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent"
            android:src="@drawable/media_player_ic_tab_nowplaying" />

    <com.miui.player.ui.view.RepeatingImageButton
            android:id="@+id/prev"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10.0dip"
            android:src="@drawable/media_player_prev_button_selector"
            style="@android:style/MediaButton.Previous" />

    <ImageButton
            android:id="@+id/pause"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.0dip"
            android:layout_marginRight="0.0dip"
            style="@android:style/MediaButton.Play" />

    <com.miui.player.ui.view.RepeatingImageButton
            android:id="@+id/next"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10.0dip"
            android:src="@drawable/media_player_next_button_selector"
            style="@android:style/MediaButton.Next" />

    <TextView
            android:textSize="10.0dip"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/favorite_list"
            android:background="@drawable/media_player_ic_tab_favorite"
            android:paddingBottom="3.0dip"
            android:layout_width="50.0dip"
            android:layout_height="44.0dip" />
</LinearLayout>