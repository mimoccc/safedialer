<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/appwidget_control"
        android:paddingRight="10.0dip"
        android:paddingBottom="4.0dip"
        android:layout_width="200.0dip"
        android:layout_height="50.0dip"
        android:layout_marginLeft="95.0dip"
        android:layout_below="@id/title"
        android:layout_alignParentBottom="true">

    <ImageButton
            android:id="@+id/control_pre"
            android:background="@android:color/transparent"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/appwidget_button_prev"
            android:scaleType="center"
            android:layout_weight="1.0" />

    <ImageButton
            android:id="@+id/control_play"
            android:background="@android:color/transparent"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/appwidget_button_play"
            android:scaleType="center"
            android:layout_weight="1.0" />

    <ImageButton
            android:id="@+id/control_pause"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/appwidget_button_pause"
            android:scaleType="center"
            android:layout_weight="1.0" />

    <ImageButton
            android:id="@+id/control_next"
            android:background="@android:color/transparent"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:src="@drawable/appwidget_button_next"
            android:scaleType="center"
            android:layout_weight="1.0" />

</LinearLayout>