<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10.0dip"
        android:layout_marginRight="10.0dip">

    <RelativeLayout
            android:orientation="horizontal"
            android:background="@drawable/appwidget_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5.0dip"
            >

        <TextView
                android:textSize="14.0sp"
                android:textStyle="bold"
                android:textColor="#ff000000"
                android:gravity="center"
                android:id="@id/title"
                android:paddingRight="10.0dip"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="10.0dip"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="95.0dip"
                android:layout_marginTop="5.0dip"
                android:singleLine="true"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true" />

        <include layout="@layout/media_player_album_appwidget_control" />

    </RelativeLayout>

    <ImageView
            android:gravity="center"
            android:layout_gravity="center|left|top"
            android:id="@+id/album"
            android:layout_width="67.0dip"
            android:layout_height="67.0dip"
            android:layout_marginLeft="16.0dip"
            android:layout_marginTop="0.5dip"
            android:src="@drawable/default_album"
            android:scaleType="fitXY" />

    <ImageView
            android:gravity="center"
            android:layout_gravity="center|left|top"
            android:id="@+id/album_background"
            android:layout_width="72.0dip"
            android:layout_height="72.0dip"
            android:layout_marginLeft="13.0dip"
            android:src="@drawable/appwidget_album_bg"
            android:scaleType="fitXY" />

</FrameLayout>