<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:gravity="center"
        android:id="@id/player_common"
        android:background="@drawable/player_common"
        android:layout_height="wrap_content"
        android:layout_width="match_parent">

    <ImageButton
            android:id="@+id/shuffle"
            android:background="@android:color/transparent"
            android:padding="0.0dip"
            android:layout_width="wrap_content"
            android:layout_height="36.0dip"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

    <com.miui.player.ui.view.RepeatingImageButton
            android:id="@id/prev"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15.0dip"
            android:src="@drawable/media_player_prev_button_selector"
            style="@android:style/MediaButton.Previous" />

    <ImageButton
            android:id="@id/pause"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0.0dip"
            android:layout_marginRight="0.0dip"
            style="@android:style/MediaButton.Play" />

    <com.miui.player.ui.view.RepeatingImageButton
            android:id="@id/next"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15.0dip"
            android:src="@drawable/media_player_next_button_selector"
            style="@android:style/MediaButton.Next" />

    <ImageButton
            android:id="@+id/repeat"
            android:background="@android:color/transparent"
            android:padding="0.0dip"
            android:layout_width="wrap_content"
            android:layout_height="36.0dip"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
</LinearLayout>