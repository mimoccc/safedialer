<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@drawable/audio_player_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

    <TextView
            android:textSize="20.0dip"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:id="@+id/navigation_title"
            android:paddingRight="13.0dip"
            android:layout_width="fill_parent"
            android:layout_height="80dp"
            android:layout_marginLeft="13.0dip"
            android:text="my_music"
            android:singleLine="true" />

    <View
            android:id="@+id/separator_view"
            android:background="@color/white_10_transparent"
            android:layout_width="fill_parent"
            android:layout_height="1.0px"
            android:layout_below="@id/navigation_title" />

    <TextView
            android:textSize="20.0dip"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/songtab"
            android:background="@drawable/media_player_navigation_bg"
            android:paddingTop="30.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginBottom="10.0dip"
            android:text="track"
            android:drawableTop="@drawable/navigation_song"
            android:layout_below="@id/separator_view"
            android:layout_alignParentLeft="true" />

    <TextView
            android:textSize="20.0dip"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/artisttab"
            android:background="@drawable/media_player_navigation_bg"
            android:paddingTop="30.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="13.0dip"
            android:layout_marginBottom="10.0dip"
            android:text="artist"
            android:drawableTop="@drawable/navigation_artist"
            android:layout_below="@id/separator_view"
            android:layout_alignParentRight="true" />

    <TextView
            android:textSize="20.0dip"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/albumtab"
            android:background="@drawable/media_player_navigation_bg"
            android:paddingTop="30.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13.0dip"
            android:text="album"
            android:drawableTop="@drawable/navigation_album"
            android:layout_below="@id/songtab"
            android:layout_alignParentLeft="true" />

    <TextView
            android:textSize="20.0dip"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/playlisttab"
            android:background="@drawable/media_player_navigation_bg"
            android:paddingTop="30.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="13.0dip"
            android:text="playlist"
            android:drawableTop="@drawable/navigation_playlist"
            android:layout_below="@id/artisttab"
            android:layout_alignParentRight="true" />

    <LinearLayout
            android:orientation="vertical"
            android:id="@id/media_player_buttonbar_wrap_id"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

        <include layout="@layout/media_player_bottom_nowplaying" />

        <include layout="@layout/media_player_buttonbar" />

    </LinearLayout>

</RelativeLayout>