<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/album_display"
        android:paddingTop="20.0dip"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

    <ImageView
            android:id="@+id/playing_album"
            android:paddingLeft="10.0dip"
            android:layout_width="222.0dip"
            android:layout_height="210.0dip"
            android:scaleType="fitXY"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true" />

    <ImageView
            android:id="@+id/playing_album_project"
            android:paddingLeft="10.0dip"
            android:layout_width="222.0dip"
            android:layout_height="222.0dip"
            android:scaleType="fitXY"
            android:layout_below="@id/playing_album"
            android:layout_alignLeft="@id/playing_album" />

    <ImageView
            android:background="@drawable/album_playing_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true" />

</RelativeLayout>