<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:orientation="vertical"
        android:background="@drawable/audio_player_playing_bg"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">

    <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">

        <com.miui.player.ui.view.PlayingGallery
                android:id="@id/display_gallery"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="50.0dip"
                android:layout_marginBottom="68.0dip"
                android:cacheColorHint="@android:color/transparent"
                android:spacing="20.0dip" />
    </LinearLayout>

    <View
            android:background="@drawable/audio_player_playing_mask"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />

    <TextView
            android:textSize="16.0sp"
            android:textColor="#80ffffff"
            android:gravity="center"
            android:id="@id/trackname"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50.0dip"
            android:layout_marginTop="6.0dip"
            android:layout_marginRight="50.0dip"
            android:maxWidth="200.0dip"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            style="@style/MarqueeTextView" />

    <TextView
            android:textSize="14.0sp"
            android:textColor="#30ffffff"
            android:gravity="center"
            android:id="@id/artistname"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50.0dip"
            android:layout_marginRight="50.0dip"
            android:maxWidth="200.0dip"
            android:layout_below="@id/trackname"
            style="@style/MarqueeTextView" />

    <ImageView
            android:id="@id/playing_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:src="@drawable/playing_dot"
            android:scaleType="fitCenter"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true" />

    <include
            android:orientation="horizontal"
            android:paddingLeft="10.0dip"
            android:paddingRight="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            layout="@layout/media_player_common" />

    <com.miui.player.ui.view.SpectrumVisualizer xmlns:miui="http://schemas.android.com/apk/res/com.miui.player"
            android:gravity="center_horizontal"
            android:id="@id/spectrum_visualizer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="67.0dip"
            android:scaleType="center"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            miui:symmetry="true"
            miui:visual_width="80"
            miui:visual_height="20"
            miui:height_per_cell="6" />

    <ImageView
            android:gravity="center_horizontal"
            android:id="@id/spectrum_visualizer_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80.0dip"
            android:src="@drawable/sliding_panel_visualization_mask"
            android:scaleType="center"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />

    <ImageView
            android:id="@id/active_indexer_lyric"
            android:layout_width="34.0dip"
            android:layout_height="34.0dip"
            android:layout_marginBottom="2.0dip"
            android:src="@drawable/lyric_indexer_off"
            android:scaleType="center"
            android:layout_above="@id/spectrum_visualizer"
            android:layout_centerHorizontal="true" />

    <ImageView
            android:id="@id/active_indexer_album"
            android:layout_width="34.0dip"
            android:layout_height="34.0dip"
            android:layout_marginBottom="2.0dip"
            android:src="@drawable/album_indexer_on"
            android:scaleType="center"
            android:layout_toLeftOf="@id/active_indexer_lyric"
            android:layout_above="@id/spectrum_visualizer" />

    <ImageView
            android:id="@id/active_indexer_playlist"
            android:layout_width="34.0dip"
            android:layout_height="34.0dip"
            android:layout_marginBottom="2.0dip"
            android:src="@drawable/playlist_indexer_off"
            android:scaleType="center"
            android:layout_toRightOf="@id/active_indexer_lyric"
            android:layout_above="@id/spectrum_visualizer" />

    <SeekBar
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@android:id/progress"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-19.0dip"
            android:progressDrawable="@drawable/media_player_progress_drawable"
            android:thumb="@drawable/media_player_progress_thumb_selector"
            android:thumbOffset="20.0dip"
            android:layout_above="@id/player_common" />

    <TextView
            android:textAppearance="?android:textAppearanceMedium"
            android:textSize="10.0sp"
            android:textColor="#30ffffff"
            android:gravity="left"
            android:id="@id/currenttime"
            android:paddingLeft="10.0dip"
            android:layout_width="100.0dip"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-15.0dip"
            android:layout_above="@android:id/progress"
            android:layout_alignParentLeft="true" />

    <TextView
            android:textAppearance="?android:textAppearanceMedium"
            android:textSize="10.0sp"
            android:textColor="#30ffffff"
            android:gravity="right"
            android:id="@id/totaltime"
            android:paddingRight="10.0dip"
            android:layout_width="100.0dip"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-15.0dip"
            android:layout_above="@android:id/progress"
            android:layout_alignParentRight="true" />

    <ImageView
            android:id="@id/add_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            android:layout_marginRight="5.0dip"
            android:scaleType="center"
            android:layout_alignTop="@id/spectrum_visualizer"
            android:layout_alignParentRight="true" />

</RelativeLayout>